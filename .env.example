# =============================================================
# CLINIC MVP — Environment Variables Template
# =============================================================
# USAGE: cp .env.example .env
# Then fill in real values in .env (it is gitignored!)
# NEVER commit .env or any file with real credentials!
# =============================================================

# ----- VPS / SSH ------------------------------------------
VPS_HOST=62.84.100.97
VPS_USER=root
VPS_PASSWORD=your_vps_password_here

# ----- Telegram Bot ----------------------------------------
BOT_TOKEN=your_telegram_bot_token_here
BOT_USERNAME=dentaliya2_bot

# ----- MQTT ------------------------------------------------
MQTT_HOST=10.77.0.1
MQTT_PORT=1883
MQTT_USER=clinic
MQTT_PASS=your_mqtt_password_here

# ----- AI/LLM Providers ------------------------------------
# Google Gemini (AI Studio) - generate at aistudio.google.com
# Format: GOOGLE_API_KEYS=key1,key2,key3 (comma-separated for rotation)
GOOGLE_API_KEYS=your_gemini_key_here

# Groq API
GROQ_API_KEYS=gsk_your_key_here,gsk_another_key_here

# OpenAI (optional)
OPENAI_API_KEY=sk_your_key_here

# ----- Database (dental-crm backend) ----------------------
DATABASE_URL=postgresql://user:password@localhost:5432/dental_crm

# ----- Frontend (dental-crm/apps/web) ---------------------
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001

# =============================================================
# HOW TO STORE KEYS SAFELY:
# 1. Put keys in .env (this file's non-example counterpart)
# 2. dental-crm uses dental-crm/local-secrets/*.env (gitignored)
# 3. For ShadowAnalyst: edit ShadowAnalyst/config.json (gitignored)
#    or load from environment: os.getenv("GOOGLE_API_KEYS").split(",")
# NEVER hardcode keys directly in Python/JS/TS files!
# =============================================================
