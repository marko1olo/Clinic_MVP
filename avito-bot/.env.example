# Образец окружения. Скопировать в .env и заполнить.
# .env в .gitignore и никогда не коммитится. Значения не выводить в лог.

# --- LLM ---------------------------------------------------------------------
# Comma-separated, несколько ключей в ОДНОЙ переменной. На ноутбуке: 10 и 7.
# Чем больше ключей, тем незаметнее кулдаун 300 с при 429.
GOOGLE_API_KEYS=
GROQ_API_KEYS=

# Необязательные переопределения каскада; по умолчанию берётся brain/llm/cascade.py
AVITO_BOT_GEMINI_MODEL=
AVITO_BOT_GROQ_MODEL=

# --- Telegram ----------------------------------------------------------------
# Бот создаётся через @BotFather с аккаунта клиники. Личный аккаунт ботом не является.
TELEGRAM_BOT_TOKEN=
# Приватная группа «Денталия-2 · Авито» с ботом и администраторами.
# У групп chat_id отрицательный, у супергрупп начинается с -100.
TELEGRAM_CHAT_ID=

# --- Авито -------------------------------------------------------------------
# Персистентный профиль Chromium с авторизованной сессией. НЕ storageState.json:
# снимок не сохраняет обновлённые куки и через неделю разлогинит.
AVITO_PROFILE=C:\bots\avito-reply\.profile
# userAgent должен совпадать с Яндекс.Браузером, откуда переехали куки:
# Chromium представляется иначе, и Авито это сверяет.
AVITO_USER_AGENT=

# --- Состояние ---------------------------------------------------------------
AVITO_BOT_DB=C:\bots\avito-reply\state.db
AVITO_BOT_STATE_DIR=C:\bots\avito-reply\state

# --- Режим -------------------------------------------------------------------
# hybrid  — безопасные факты автоматом, остальное черновиком (по умолчанию)
# draft   — вообще всё через одобрение администратора
AVITO_BOT_MODE=hybrid
# Перевести первый дожим в автоотправку можно только осознанно, после того как
# статистика покажет, что администратор отправляет его без правок.
AVITO_BOT_FOLLOWUP_1_AUTO=0
