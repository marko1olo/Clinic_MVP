-// Set the corresponding bit in the bitmask
-void setLabelOutlineBit(int segmentIndex) {
-  int arrayIndex = segmentIndex / UINT_SIZE;
-  int bitIndex = segmentIndex % UINT_SIZE;
-  labelOutlineBitmasks[arrayIndex] |= 1u << bitIndex;
-}
